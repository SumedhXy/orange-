{
  "version": 1,
  "author": "Antigravity AI - CITRUS-TERRA Project",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 100,
      "left": 100,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -90,
      "left": 100,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "tof_sensor",
      "top": 20,
      "left": 360,
      "attrs": { "distance": "120" }
    },
    {
      "type": "wokwi-ky-040",
      "id": "wheel_encoder",
      "top": 180,
      "left": 360,
      "attrs": {}
    },
    {
      "type": "wokwi-relay-module",
      "id": "spray_solenoid",
      "top": -90,
      "left": 360,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_disease",
      "top": 80,
      "left": -60,
      "attrs": { "color": "red", "label": "PEST / GUMMOSIS" }
    },
    {
      "type": "wokwi-led",
      "id": "led_healthy",
      "top": 140,
      "left": -60,
      "attrs": { "color": "green", "label": "HEALTHY TREE" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "cabin_buzzer",
      "top": 210,
      "left": -60,
      "attrs": { "volume": "0.3" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_disease_sim",
      "top": 300,
      "left": 115,
      "attrs": { "color": "red", "label": "SIMULATE PEST" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "oled:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled:SCL", "esp:22", "yellow", [ "v0" ] ],
    [ "oled:SDA", "esp:21", "blue", [ "v0" ] ],

    [ "tof_sensor:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "tof_sensor:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "tof_sensor:TRIG", "esp:5", "purple", [ "v0" ] ],
    [ "tof_sensor:ECHO", "esp:18", "orange", [ "v0" ] ],

    [ "wheel_encoder:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "wheel_encoder:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "wheel_encoder:CLK", "esp:19", "green", [ "v0" ] ],
    [ "wheel_encoder:DT", "esp:23", "cyan", [ "v0" ] ],

    [ "spray_solenoid:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "spray_solenoid:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "spray_solenoid:IN", "esp:25", "magenta", [ "v0" ] ],

    [ "led_disease:A", "esp:26", "red", [ "v0" ] ],
    [ "led_disease:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "led_healthy:A", "esp:27", "green", [ "v0" ] ],
    [ "led_healthy:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "cabin_buzzer:2", "esp:14", "red", [ "v0" ] ],
    [ "cabin_buzzer:1", "esp:GND.1", "black", [ "v0" ] ],

    [ "btn_disease_sim:1.l", "esp:13", "brown", [ "v0" ] ],
    [ "btn_disease_sim:2.l", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
